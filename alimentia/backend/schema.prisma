datasource db {
  provider = "sqlite"
  url      = "file:./data/db/alimentia.db"
}

generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

model Patient {
  id               String     @id @default(uuid())
  name             String     @default("Paciente Nuevo")
  age              Int
  gender           String
  goal             String
  pathologies      String
  createdAt        DateTime   @default(now())
  plans            DietPlan[] 
}

model DietPlan {
  id               String   @id @default(uuid())
  patientId        String
  patient          Patient  @relation(fields: [patientId], references: [id])
  tdee_calculated  Float
  plan_json        String
  status           String   @default("BORRADOR")
  createdAt        DateTime @default(now())
}