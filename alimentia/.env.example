LLM_MODEL=llama3.2:3b
OLLAMA_KEEP_ALIVE=-1
ALIMENTIA_OLLAMA_PRELOAD=true

# Rutas de recursos externos dentro del contenedor backend.
# Ver alimentia/backend/src/app/services/rag_engine.py y food_db.py.
ALIMENTIA_KNOWLEDGE_PATH=/app/data/pdfs
ALIMENTIA_FOOD_DB_PATH=/app/data/tables/BAM.xlsx
ALIMENTIA_KNOWLEDGE_MANIFEST_PATH=/app/data/knowledge_base/manifest.json

# Generación de borrador con LLM (Fase 4).
ALIMENTIA_RAG_TOP_K=3
ALIMENTIA_BAM_SAMPLE_SIZE=8
ALIMENTIA_LLM_TEMPERATURE=0.2
ALIMENTIA_LLM_CONTEXT_TOKENS=4096
# Opcional: none, low, medium o high; solo se aplica si el modelo lo declara.
ALIMENTIA_LLM_REASONING_EFFORT=
ALIMENTIA_LLM_TIMEOUT_SECONDS=240

# Identidad profesional mínima para aprobar/rechazar/editar sin autenticación
# completa (Fase 5). Nunca "Nutriólogo" genérico: un identificador explícito
# de actor de sistema para este despliegue de demo/dev.
ALIMENTIA_DEFAULT_ACTOR=profesional-demo
